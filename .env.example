# 0G
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_STORAGE_URL=https://indexer-storage-testnet-turbo.0g.ai
OG_PRIVATE_KEY=0xchange-me

# ENS (Sepolia)
ENS_PARENT_NAME=tribunal.eth
ENS_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/CHANGE
ENS_PRIVATE_KEY=0xchange-me

# LLM — provider precedence: OpenAI > OpenRouter > Anthropic > canned.
# Override with LLM_PROVIDER=openai|openrouter|anthropic|canned to force one.
#
# OpenAI (paid) — preferred for demos. Reliable JSON mode, fast.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_ORG=

# OpenRouter (free models available) — handy for debugging without burning credits.
# Set LLM_PROVIDER=openrouter to force this even when OPENAI_API_KEY is set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Anthropic (paid).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# AXL ports (override only if you remap them in scripts/axl-up.sh).
AXL_CLERK_URL=http://127.0.0.1:9002
AXL_LAWYER_A_URL=http://127.0.0.1:9012
AXL_LAWYER_B_URL=http://127.0.0.1:9022
AXL_JUDGE_URL=http://127.0.0.1:9032

# Comma-separated EVM addresses to admit on deploy. Optional but the demo
# expects at least JUDGE_ADDRESSES populated so submitRuling works.
JUDGE_ADDRESSES=0x...,0x...,0x...
LAWYER_ADDRESSES=0x...,0x...
